generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Unidade {
  id            Int      @id @default(autoincrement())
  nome          String
  slug          String   @unique
  belleEmail    String
  bellePassword String
  belleEstabId  Int      @default(1)
  ativa         Boolean  @default(true)
  createdAt     DateTime @default(now())
  usuarios      Usuario[]
  metas         MetaDiaria[]
  metasMensais  MetaMensal[]
  usuariosCoord UsuarioUnidade[]
  rotinaTemplates RotinaTemplate[]
  tarefas       TarefaRotina[]
  reembolsos    ReembolsoUnidade[]
  permutaConfig PermutaConfig?
  pexPremiacoes PexPremiacao[]
}

// Cadastro das empresas (razão social / CNPJ / dados fiscais) por unidade.
model Empresa {
  id                 Int      @id @default(autoincrement())
  razaoSocial        String
  cnpj               String   @unique
  nomeFantasia       String   @default("")
  inscricaoEstadual  String   @default("")
  inscricaoMunicipal String   @default("") // CCM / IM
  logradouro         String   @default("")
  numero             String   @default("")
  complemento        String   @default("")
  bairro             String   @default("")
  cidade             String   @default("")
  uf                 String   @default("SP")
  cep                String   @default("")
  telefone           String   @default("")
  emailFiscal        String   @default("")
  unidadeSlug        String   @default("") // vínculo opcional com a unidade
  ativa              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MetaMensal {
  id               Int      @id @default(autoincrement())
  unidadeId        Int
  unidade          Unidade  @relation(fields: [unidadeId], references: [id])
  ano              Int
  mes              Int      // 1=Jan ... 12=Dez
  metaFaturamento  Float    @default(0)   // Total caixa + parcerias
  metaHoras        Float    @default(0)   // Horas de atendimento
  metaVendas       Float    @default(0)   // Vendas da recepção
  premioFaturamento Float   @default(0)   // R$ prêmio se bater meta faturamento
  premioHoras      Float    @default(0)
  premioVendas     Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([unidadeId, ano, mes])
}

model Usuario {
  id         String   @id @default(cuid())
  nome       String
  email      String   @unique
  senha      String
  perfil     String   @default("ATENDIMENTO")
  unidadeId  Int?
  unidade    Unidade? @relation(fields: [unidadeId], references: [id])
  ativo      Boolean  @default(true)
  primeirAcesso Boolean @default(false)  // true = obrigada a trocar a senha antes de usar
  createdAt  DateTime @default(now())
  logs       LogAuditoria[]
  unidadesCoord UsuarioUnidade[]
}

// ─── Avaliação de Terapeutas (indicadores manuais/integrados + nota do gestor) ────
// Uma linha por terapeuta, unidade e semestre. Indicadores 4/5/6 chegam por
// integração futura; avaliacaoGestor é lançada manualmente (−1 a +1).
model TerapeutaAvaliacao {
  id                  Int      @id @default(autoincrement())
  unidadeSlug         String
  terapeutaChave      String   // nome normalizado (casa com o nome do Belle)
  terapeutaNome       String   // nome de exibição (como veio do Belle)
  periodo             String   // semestre, ex.: "2026-S2"
  recomendacaoCliente Float?
  horasTreinamento    Float?
  avaliacaoColegas    Float?
  avaliacaoGestor     Float?   // −1 a +1
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @default(now())

  @@unique([unidadeSlug, terapeutaChave, periodo])
}

// Pesos dos 6 indicadores POR UNIDADE (soma deve dar 100). Default = último semestre.
model TerapeutaPesos {
  id                Int      @id @default(autoincrement())
  unidadeSlug       String   @unique
  pesoProdutividade Float    @default(25)
  pesoFidelizacao   Float    @default(35)
  pesoNps           Float    @default(20)
  pesoRecomendacao  Float    @default(10)
  pesoTreinamento   Float    @default(0)
  pesoColegas       Float    @default(10)
  atualizadoEm      DateTime @default(now())
}

// Faixas de categoria GLOBAIS pela Nota Final (Diamante/Ouro/Prata/Bronze).
model TerapeutaCategoriaFaixa {
  id           Int      @id @default(autoincrement())
  chave        String   @unique @default("global")
  minDiamante  Float    @default(9.5)
  minOuro      Float    @default(8.5)
  minPrata     Float    @default(7.5)
  atualizadoEm DateTime @default(now())
}

model MetaDiaria {
  id          Int      @id @default(autoincrement())
  unidadeId   Int
  unidade     Unidade  @relation(fields: [unidadeId], references: [id])
  diaSemana   Int      // 0=Dom, 1=Seg, ..., 6=Sab
  metaReceita Float    @default(0)
  metaAtend   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LogAuditoria {
  id        Int      @id @default(autoincrement())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  acao      String
  entidade  String
  dados     String?
  createdAt DateTime @default(now())
}

model ClienteScore {
  id                   Int       @id @default(autoincrement())
  unidadeSlug          String
  clienteId            Int?
  nomeCliente          String
  telefone             String?
  email                String?

  // Frequência — de Report 194
  dataCadastro         DateTime?
  primeiraSessao       DateTime?
  ultimaSessao         DateTime?
  totalSessoes         Int       @default(0)

  // Segmento de frequência: NOVO | ATIVO | EM_RISCO | PERDIDO
  statusFrequencia     String    @default("ATIVO")

  // Pacote — de Report 184
  temPacote            Boolean   @default(false)
  statusPacote         String?   // ATIVO | A_VENCER | VENCIDO | FINALIZADO
  nomePlano            String?
  dataVencimentoPacote DateTime?
  sessoesRestantes     Int       @default(0)

  // Tem ao menos 1 pacote ativo de verdade (sessão sobrando + validade futura).
  // Usado para BLOQUEAR mensagens de renovação a quem já está coberto.
  temPacoteAtivo       Boolean   @default(false)

  // Tem ao menos 1 pacote SUSPENSO no Belle (não utilizável — caso delicado).
  // Sinaliza ⚠️ na fila; envio continua permitido (recepção decide).
  temPacoteSuspenso    Boolean   @default(false)

  // Flag especial
  isFrequenteSemPacote Boolean   @default(false)  // 3+ sessões avulsas sem pacote

  // Agendamento futuro (atualizado no sync)
  temAgendamentoFuturo Boolean   @default(false)

  // Rastreamento de contato — não sobrescrito pelo sync
  ultimoContato        DateTime?  // quando a recepção enviou mensagem
  motivoContato        String?    // grupo ativo no momento: "PACOTE_A_VENCER", "EM_RISCO", etc.

  ultimoCalculo        DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([unidadeSlug, nomeCliente])
  @@index([unidadeSlug, statusFrequencia])
  @@index([unidadeSlug, statusPacote])
  @@index([unidadeSlug, isFrequenteSemPacote])
}

model HistoricoContato {
  id                   Int       @id @default(autoincrement())
  unidadeSlug          String
  clienteScoreId       Int?      // referência estável ao ClienteScore
  nomeCliente          String
  telefone             String?
  motivoContato        String    // "PACOTE_A_VENCER" | "EM_RISCO" | etc.

  // Snapshot do momento do contato (para detectar conversão depois)
  statusPacoteSnap     String?
  statusFreqSnap       String
  sessoesRestSnap      Int       @default(0)
  ultimaSessaoSnap     DateTime?

  criadoEm             DateTime  @default(now())

  // Resultado (preenchido automaticamente no próximo sync)
  converteu            Boolean   @default(false)
  tipoConversao        String?   // "nova_sessao" | "renovacao_pacote" | "novo_pacote"
  dataConversao        DateTime?

  @@index([unidadeSlug, criadoEm])
  @@index([clienteScoreId, converteu])
}

model TemplateMensagem {
  cluster   String   @id      // ex.: PACOTE_A_VENCER, EM_RISCO, NOVO...
  texto     String
  updatedAt DateTime @updatedAt
}

// Base de clientes que pagam com TotalPass (2 sessões/mês). Atualizada pelo sync
// a partir do Report 103 (Movimentação) + agenda do mês. Campos manuais (planoCancelado,
// ultimoContato) NÃO são sobrescritos pelo sync.
model ClienteTotalPass {
  id             Int       @id @default(autoincrement())
  unidadeSlug    String
  clienteId      Int?
  nomeCliente    String
  telefone       String?
  usosAno        Int       @default(0)   // qtd de usos TotalPass no ano
  ultimoUso      DateTime?                // última confirmação TotalPass
  mesRef         String                   // "2026-08" — mês de referência da contagem
  sessoesMes     Int       @default(0)    // sessões na agenda do mês (0/1/2+)

  planoCancelado Boolean   @default(false) // MANUAL: cliente avisou que cancelou o TotalPass
  ultimoContato  DateTime?                 // MANUAL/rastreio: última msg enviada pelo ERP
  motivoContato  String?

  atualizadoEm   DateTime  @updatedAt
  criadoEm       DateTime  @default(now())

  @@unique([unidadeSlug, nomeCliente])
  @@index([unidadeSlug])
}

// Fila de sincronização (outbox) das mensagens do ERP para o LeadFlow.
// Cada contato registrado vira uma linha aqui; o processador (quando LIGADO)
// espelha no LeadFlow. Espelhar NÃO envia nada ao cliente — só registra histórico.
model LeadFlowOutbox {
  id          Int       @id @default(autoincrement())
  unidadeSlug String
  nomeCliente String
  telefone    String?
  texto       String
  motivo      String
  status      String    @default("PENDENTE") // PENDENTE | ENVIADO | ERRO
  tentativas  Int       @default(0)
  erro        String?
  criadoEm    DateTime  @default(now())
  enviadoEm   DateTime?

  @@index([status])
}

// Bloqueio manual de contato (cancelamento / opt-out) por TELEFONE. Alimentado pela
// Central via POST /api/tarefas-do-dia/:id/cancelar. Remove o cliente de TODOS os
// clusters da fila. unidadeSlug="*" = bloqueio global (todas as unidades — opt-out).
model ContatoBloqueado {
  id           Int      @id @default(autoincrement())
  unidadeSlug  String   // slug da unidade; "*" = todas (opt-out global)
  telefone     String   // apenas dígitos
  nomeCliente  String?
  motivo       String   // SEM_PLANO | OPT_OUT | OUTRO (ou texto livre)
  obs          String?
  criadoEm     DateTime @default(now())

  @@unique([unidadeSlug, telefone])
  @@index([telefone])
}

model VoucherCache {
  id               Int      @id @default(autoincrement())
  dataIni          String
  dataFim          String
  totalReembolso   Float    @default(0)
  totalValidados   Int      @default(0)
  pendentesValidacao Int    @default(0)
  validacaoManual  Int      @default(0)
  validacaoAutomatica Int   @default(0)
  vouchers         String   // JSON array de vouchers
  savedAt          DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([dataIni, dataFim])
  @@index([dataIni, dataFim])
}

// ─── Cockpit de Rotinas (Coordenação / Recepção) ────────────────────────────────
// Vínculo N:N entre usuário e unidades — usado pela COORDENACAO, que pode cuidar
// de 1, 2 ou mais unidades. RECEPCAO continua usando Usuario.unidadeId (1 unidade).
model UsuarioUnidade {
  id        Int      @id @default(autoincrement())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  unidadeId Int
  unidade   Unidade  @relation(fields: [unidadeId], references: [id])
  criadoEm  DateTime @default(now())

  @@unique([usuarioId, unidadeId])
  @@index([usuarioId])
}

// Catálogo de rotinas: a definição reutilizável de cada rotina/checklist.
// A partir daqui o motor gera as TarefaRotina do dia para cada unidade.
model RotinaTemplate {
  id           Int      @id @default(autoincrement())
  chave        String   @unique               // slug estável (ex.: "agenda-preenchimento")
  titulo       String
  descricao    String?
  area         String                         // COORDENACAO | RECEPCAO
  frente       String?                        // agrupamento (Agenda, Estoque, NPS...)
  frequencia   String                         // DIARIA | SEMANAL | MENSAL | SOB_DEMANDA
  ordem        Int      @default(100)         // ordenação (1 = primeira do dia)
  diaSemana    Int?                           // 0=Dom..6=Sab (SEMANAL)
  diaDoMes     Int?                           // 1..28 (MENSAL) — dia que a tarefa nasce
  diaLimite    Int?                           // 1..28 (MENSAL) — dia limite p/ concluir (janela)
  horaPrevista String?                        // "10:00"
  alertaDias   Int?                           // prazo p/ alerta de pendência (ex.: 3 = Financeiro)
  acaoApp      String?                        // liga a tarefa a um mini-app (ex.: "caixa")
  unidadeId    Int?                           // null = vale p/ todas as unidades
  unidade      Unidade? @relation(fields: [unidadeId], references: [id])
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([area, frequencia])
}

// Instância de tarefa: nasce do sistema (a partir de um template, por cadência) ou
// é DELEGADA por alguém de cima (Dona→Coord, Coord→Recepção). Carrega status,
// acúmulo (dataOriginal vs dataRef) e rastro de delegação/conclusão.
model TarefaRotina {
  id             Int       @id @default(autoincrement())
  unidadeId      Int
  unidade        Unidade   @relation(fields: [unidadeId], references: [id])
  templateId     Int?                          // null = tarefa delegada/avulsa
  area           String                        // COORDENACAO | RECEPCAO
  titulo         String
  descricao      String?
  frequencia     String?
  ordem          Int       @default(100)
  dataRef        String                        // "2026-09-01" — dia a que pertence hoje
  dataOriginal   String                        // dia em que nasceu (mede atraso/acúmulo)
  horaPrevista   String?
  status         String    @default("PENDENTE") // PENDENTE | EM_ANDAMENTO | CONCLUIDA
  origem         String    @default("SISTEMA")  // SISTEMA | DELEGADA
  criadoPorId    String?                        // quem delegou
  criadoPorNome  String?
  atribuidoArea  String?                        // alvo da delegação: COORDENACAO | RECEPCAO
  prazo          String?                        // data limite (delegada) ou p/ alerta
  alertaDias     Int?
  acaoApp        String?                        // mini-app ligado (ex.: "caixa")
  concluidaEm    DateTime?
  concluidaPorId String?
  concluidaPorNome String?
  observacao     String?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  @@unique([unidadeId, templateId, dataRef])
  @@index([unidadeId, dataRef])
  @@index([unidadeId, status])
}

// Controle de caixa da recepção: 1 registro por unidade/dia. Abertura (fundo de
// troco) e fechamento (valor contado), com quem/quando e observações. Fase 2 trará
// recebimentos do Belle + saídas com foto e diferença automática.
model ContagemCaixa {
  id              Int       @id @default(autoincrement())
  unidadeId       Int
  data            String    // YYYY-MM-DD
  fundoAbertura     Float?
  abertoPorNome     String?   // quem registrou no sistema (logado)
  abertoContadoPor  String?   // quem fez a contagem física
  abertoEm          DateTime?
  obsAbertura       String?
  valorFechamento   Float?
  fechadoPorNome    String?   // quem registrou no sistema (logado)
  fechadoContadoPor String?   // quem fez a contagem física
  fechadoEm         DateTime?
  obsFechamento     String?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  @@unique([unidadeId, data])
  @@index([unidadeId, data])
}

// Saída de caixa (sangria/despesa) do dia, com foto opcional da notinha (fotoPath).
model SaidaCaixa {
  id            Int      @id @default(autoincrement())
  unidadeId     Int
  data          String   // YYYY-MM-DD
  valor         Float
  descricao     String
  fotoPath      String?
  criadoPorId   String?
  criadoPorNome String?
  criadoEm      DateTime @default(now())

  @@index([unidadeId, data])
}

// Tratativa de um caso de NPS (detrator/neutro). O caso vem do Belle (Report 21);
// aqui a coordenadora registra a AÇÃO TOMADA. chaveCaso = idAtendimento (ou hash).
model TratativaNps {
  id             Int      @id @default(autoincrement())
  unidadeId      Int
  origem         String   @default("NPS") // NPS | GOOGLE
  chaveCaso      String
  cliente        String
  classificacao  String
  nota           Int?
  comentario     String?
  acaoTomada     String
  tipoProblema   String?  // tipologia (para métricas): Atendimento, Profissional...
  cortesiaConcedida Boolean?
  clienteSatisfeito String? // Sim | Não | Sem retorno
  tratadoPorId   String?
  tratadoPorNome String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  @@unique([unidadeId, chaveCaso])
  @@index([unidadeId])
  @@index([unidadeId, tipoProblema])
}

// ─── Conferência Mensal de Reembolso de Vouchers ────────────────────────────────
// Substitui a planilha "Reembolso vouchers <mês>". Um ReembolsoMes por (ano,mes);
// uma ReembolsoUnidade por unidade (colunas C..K da planilha). Vouchers/Omni/
// Cortesias vêm do WordPress (relay da sessão real); Compras/Treinamento são
// manuais; Royalties/Mkt = 8% do caixa (só Higienópolis). PEX (prêmio com vigência)
// dá 20% de desconto em compras + treinamento gratuito às unidades ganhadoras.
model ReembolsoMes {
  id           Int      @id @default(autoincrement())
  ano          Int
  mes          Int                              // 1..12
  status       String   @default("ABERTO")      // ABERTO | FECHADO
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  unidades     ReembolsoUnidade[]

  @@unique([ano, mes])
}

model ReembolsoUnidade {
  id             Int          @id @default(autoincrement())
  reembolsoMesId Int
  mesRef         ReembolsoMes @relation(fields: [reembolsoMesId], references: [id], onDelete: Cascade)
  unidadeId      Int
  unidade        Unidade      @relation(fields: [unidadeId], references: [id])

  // Vindos do WordPress (relay)
  vouchers          Float @default(0)           // C — total reembolso (filtro utilização)
  omnichannel       Float @default(0)           // E — total reembolso (filtro venda + omni)
  cortesiaUsada     Float @default(0)           // soma das cortesias (R$0) usadas no mês
  cortesiaReembolso Float @default(0)           // F — excedente sobre o crédito (motor de permuta)
  creditoInicial    Float @default(0)           // crédito de permuta disponível no mês
  saldoAcumulado    Float @default(0)           // saldo p/ o mês seguinte

  // Manuais
  compras     Float @default(0)                 // G — bruto (antes do ×80% do PEX)
  treinamento Float @default(0)                 // I — bruto

  // Calculado / integração
  faturamentoCaixa Float @default(0)            // base do royalties (Belle)
  royaltiesMkt     Float @default(0)            // J — 8% do caixa (só Higienópolis)

  // PEX — snapshot do mês (20% desc. compras + treinamento gratuito)
  pex Boolean @default(false)

  // Conciliação bancária (o que caiu na conta vs o valor a reembolsar)
  valorRecebido Float   @default(0)
  conciliado    Boolean @default(false)

  fetchedAt    DateTime?                         // quando o WP foi puxado
  atualizadoEm DateTime  @updatedAt
  cortesias    ReembolsoCortesia[]
  compraItens  ReembolsoCompra[]
  treinamentoItens ReembolsoTreinamento[]

  @@unique([reembolsoMesId, unidadeId])
  @@index([unidadeId])
}

model ReembolsoCortesia {
  id                 Int              @id @default(autoincrement())
  reembolsoUnidadeId Int
  reembolsoUnidade   ReembolsoUnidade @relation(fields: [reembolsoUnidadeId], references: [id], onDelete: Cascade)
  codigo             String
  nome               String
  valor              Float            @default(0)
  dataUtilizacao     String?

  @@index([reembolsoUnidadeId])
}

// Itens de compra lançados manualmente (memória de cálculo do total de Compras).
// A coluna Compras da unidade é a SOMA destes itens.
model ReembolsoCompra {
  id                 Int              @id @default(autoincrement())
  reembolsoUnidadeId Int
  reembolsoUnidade   ReembolsoUnidade @relation(fields: [reembolsoUnidadeId], references: [id], onDelete: Cascade)
  descricao          String
  valor              Float            @default(0)
  criadoEm           DateTime         @default(now())

  @@index([reembolsoUnidadeId])
}

// Treinamentos de terapeutas (rastreabilidade). Cada terapeuta = R$1.000 de
// abatimento. A coluna Treinamento = nº de itens × 1000 (mas PEX ⇒ efetivo 0).
model ReembolsoTreinamento {
  id                 Int              @id @default(autoincrement())
  reembolsoUnidadeId Int
  reembolsoUnidade   ReembolsoUnidade @relation(fields: [reembolsoUnidadeId], references: [id], onDelete: Cascade)
  terapeuta          String
  criadoEm           DateTime         @default(now())

  @@index([reembolsoUnidadeId])
}

// Crédito mensal permutável e teto de acúmulo por unidade (das abas Cortesias).
model PermutaConfig {
  unidadeId             Int      @id
  unidade               Unidade  @relation(fields: [unidadeId], references: [id])
  valorMensalPermutavel Float    @default(0)
  limiteAcumulo         Float    @default(0)
  saldoInicial          Float    @default(0) // saldo acumulado que já vinha antes do 1º mês no ERP
  atualizadoEm          DateTime @updatedAt
}

// Cache do Radar Geral por período (JSON pronto). Serve instantâneo; atualizado
// pelo botão "Atualizar agora" e pelo cron diário da manhã.
model RadarCache {
  periodo      String   @id  // "2026-08-01_2026-08-31"
  dados        String        // JSON de RadarGeralData
  atualizadoEm DateTime @updatedAt
}

// Cache mensal de faturamento por unidade (histórico do dashboard). Meses fechados
// são puxados do Belle uma vez e guardados aqui; o mês atual é sempre ao vivo.
model FaturamentoHistorico {
  id           Int      @id @default(autoincrement())
  unidadeSlug  String
  ano          Int
  mes          Int      // 1..12
  caixa        Float    @default(0)
  horas        Float    @default(0)
  gympass       Float    @default(0)
  totalpass     Float    @default(0)
  voucherOnline Float    @default(0)
  atualizadoEm  DateTime @updatedAt

  @@unique([unidadeSlug, ano, mes])
}

// Cache consolidado do dashboard de UMA unidade num período (faturamento + vendas +
// nps + caixa diário + voucher). Servido instantâneo; refresh diário 7h + botão.
model DashboardCache {
  chave        String   @id  // "higienopolis_2026-09-01_2026-09-06"
  dados        String        // JSON do bundle
  atualizadoEm DateTime @updatedAt
}

// Cache do REALIZADO mensal (caixa/horas/recepção) por unidade — usado pelo menu Meta.
// Meses fechados nunca mudam → puxados do Belle uma vez e guardados; o mês atual
// vem do DashboardCache (já aquecido) e não é persistido aqui.
model RealizadoMensalCache {
  id           Int      @id @default(autoincrement())
  unidadeSlug  String
  ano          Int
  mes          Int      // 1..12
  caixa        Float    @default(0)
  horas        Float    @default(0)
  recepcao     Float    @default(0)
  atualizadoEm DateTime @updatedAt

  @@unique([unidadeSlug, ano, mes])
}

// Cache das METAS/PREMIAÇÕES oficiais vindas do app Folha (fonte da verdade).
// Atualizado a cada leitura bem-sucedida; serve de fallback se o Folha estiver fora.
model MetasFolhaCache {
  ano          Int      @id
  dados        String        // JSON com metas + premiação por unidade
  atualizadoEm DateTime @updatedAt
}

// Cache do caixa DIÁRIO por unidade (evolução diária do dashboard). Dias fechados
// nunca mudam → puxados do Belle uma vez e guardados; o dia de hoje é sempre ao vivo.
model CaixaDiarioCache {
  id           Int      @id @default(autoincrement())
  unidadeSlug  String
  dia          String   // "YYYY-MM-DD"
  valor        Float    @default(0)
  atualizadoEm DateTime @updatedAt

  @@unique([unidadeSlug, dia])
}

// Prêmio PEX com vigência: unidade ganhadora num intervalo de meses de um ano.
model PexPremiacao {
  id        Int      @id @default(autoincrement())
  unidadeId Int
  unidade   Unidade  @relation(fields: [unidadeId], references: [id])
  ano       Int
  mesInicio Int                                  // 1..12
  mesFim    Int                                  // 1..12
  criadoEm  DateTime @default(now())

  @@index([unidadeId, ano])
}

// ─── Programa de Recomendação das Terapeutas (F1) ───────────────────────────────
// No gestao a terapeuta, por atendimento, VALIDA (a validação vai pro Folha calcular
// a comissão — não fica aqui) E registra a RECOMENDAÇÃO que fez ao cliente (o
// "bloquinho" digital). Uma Recomendacao por atendimento (belleId, chave estável
// entre apps). Os itens são o que ela recomendou (óleos, chás, retorno). A VENDA/
// conversão (recepção) e a PONTUAÇÃO entram nas fases F2/F3.
model Recomendacao {
  id              Int      @id @default(autoincrement())
  belleId         String   @unique            // atendimento no Belle/Folha (casa entre apps)
  unidadeSlug     String
  usuarioId       String                      // Usuario (perfil TERAPEUTA) que registrou
  terapeutaNome   String
  clienteNome     String
  clienteTelefone String?
  dataAtendimento String                      // "YYYY-MM-DD"
  servico         String?
  // Avaliação do bloquinho (escala 1..5)
  notaSono        Int?
  notaEnergia     Int?
  notaEstresse    Int?
  pontosTensao    String?                     // texto livre (pontos de tensão identificados)
  retorno         String?                     // recomendação de retorno/frequência (texto)
  fotoPath        String?                     // foto do bloquinho preenchido
  observacao      String?
  // Ciclo de vida (usado na F2 pela recepção)
  status          String   @default("PENDENTE_VENDA") // PENDENTE_VENDA | VENDIDA | SEM_VENDA
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
  itens           RecomendacaoItem[]
  venda           Venda?

  @@index([unidadeSlug, status])
  @@index([usuarioId])
  @@index([unidadeSlug, dataAtendimento])
}

// O que a terapeuta recomendou naquele atendimento. Mapeia os checkboxes do
// bloquinho (óleos/chás) + retorno; e categorias que a recepção converte em venda.
model RecomendacaoItem {
  id             Int          @id @default(autoincrement())
  recomendacaoId Int
  recomendacao   Recomendacao @relation(fields: [recomendacaoId], references: [id], onDelete: Cascade)
  // OLEO_CALMA|OLEO_ENERGIA|OLEO_SONO|CHA_INDIANO|CHA_DETOX|CHA_ENERGIA|CHA_RELAX|
  // PACOTE|VOUCHER|NOVO_AGENDAMENTO|PRODUTO_OUTRO|RETORNO
  tipo           String
  descricao      String?
  criadoEm       DateTime     @default(now())

  @@index([recomendacaoId])
}

// ─── Terapeutas & Atendimentos (F1) ─────────────────────────────────────────────
// O gestao passa a sincronizar os atendimentos do Belle SOZINHO (réplica da folha),
// pra ser autossuficiente no dia a dia. Terapeuta = registro p/ casar o nome do Belle
// e ligar ao login (Usuario perfil TERAPEUTA). Atendimento = cada serviço realizado,
// com o status de validação (confirma/contesta). No fechamento, o que estiver
// confirmado/corrigido é enviado em LOTE pro folha calcular a comissão.
model Terapeuta {
  id          Int      @id @default(autoincrement())
  nome        String
  nomeBelle   String?                    // override p/ casar o nome como vem do Belle
  unidadeSlug String
  usuarioId   String?  @unique           // Usuario (perfil TERAPEUTA) do login, se provisionado
  colaboradorId String?                  // referência ao rh (opcional)
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  atendimentos Atendimento[]
  bolaCheckins     BolaCheckin[]
  bolaAtendimentos BolaAtendimento[]

  @@index([unidadeSlug, ativo])
}

model Atendimento {
  id                   Int        @id @default(autoincrement())
  belleId              String     @unique   // MESMA geração da folha (casa no lote do fechamento)
  unidadeSlug          String
  terapeutaId          Int?
  terapeuta            Terapeuta? @relation(fields: [terapeutaId], references: [id])
  terapeutaNome        String                // nome como veio do Belle (antes/além do matching)
  clienteNome          String
  servico              String?
  data                 String                // "YYYY-MM-DD"
  hora                 String?
  valorComissao        Float      @default(0)
  // PENDENTE | CONFIRMADO | CONTESTADO | AJUSTADO | REJEITADO
  statusValidacao      String     @default("PENDENTE")
  observacaoContestacao String?
  respostaCoord        String?               // resolução da coordenadora
  fechamentoRef        String?               // período do fechamento, ex.: "2026-09"
  enviadoFolhaEm       DateTime?             // quando entrou no lote enviado ao folha
  criadoEm             DateTime   @default(now())
  atualizadoEm         DateTime   @updatedAt

  @@index([unidadeSlug, data])
  @@index([terapeutaId, statusValidacao])
  @@index([unidadeSlug, statusValidacao, fechamentoRef])
}

// Estado da validação do mês por unidade. A coordenadora resolve as contestações e
// "libera" o fechamento (liberado=true) — a partir daí o lote confirmado é enviado
// ao Folha (F2/task 6). Um registro por (unidade, mês "YYYY-MM").
model FechamentoValidacao {
  id              Int      @id @default(autoincrement())
  unidadeSlug     String
  ref             String                     // "YYYY-MM"
  liberado        Boolean  @default(false)
  liberadoEm      DateTime?
  liberadoPorNome String?
  forcado         Boolean  @default(false)    // liberado à força (terapeuta não validou a tempo)
  forcadoInfo     String?                     // JSON: [{terapeuta, pendentes}] — o RH vê na folha
  enviadoFolhaEm  DateTime?                   // quando o lote foi enviado ao Folha
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@unique([unidadeSlug, ref])
}

// ─── Pós-venda / Conversão (F2) ─────────────────────────────────────────────────
// A recepção trabalha as recomendações (fila) e, quando o cliente compra, registra
// a VENDA classificando o que converteu. Uma venda por recomendação. Os itens são a
// base da pontuação (F3): VOUCHER/NOVO_AGENDAMENTO/PRODUTO = 1 pt (×qtd);
// PACOTE = nº de sessões pagas.
model Venda {
  id                Int          @id @default(autoincrement())
  recomendacaoId    Int          @unique
  recomendacao      Recomendacao @relation(fields: [recomendacaoId], references: [id], onDelete: Cascade)
  belleId           String
  unidadeSlug       String
  confirmadoPorId   String?
  confirmadoPorNome String?
  observacao        String?
  criadoEm          DateTime     @default(now())
  atualizadoEm      DateTime     @updatedAt
  itens             VendaItem[]

  @@index([unidadeSlug])
}

model VendaItem {
  id         Int      @id @default(autoincrement())
  vendaId    Int
  venda      Venda    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  tipo       String   // VOUCHER | NOVO_AGENDAMENTO | PRODUTO | PACOTE
  quantidade Int      @default(1) // PACOTE = nº de sessões pagas; demais = quantidade
  descricao  String?
  criadoEm   DateTime @default(now())

  @@index([vendaId])
}

// ─── Conciliação Financeira Diária (F0) ─────────────────────────────────────────
// Módulo multitenant de conciliação: réplica normalizada das movimentações do Belle
// (Report 103 c/ forma de pagamento por linha + Report 183 c/ ID único e desconto)
// confrontada com as fontes de verdade externas (operadora de cartão, banco/Pix,
// caixa em dinheiro, plataformas de parceiro). Convenção unidadeId:Int (casa com
// ContagemCaixa/SaidaCaixa). Mudança puramente aditiva — não altera tabelas existentes.

// Réplica normalizada de cada movimentação financeira do Belle (Report 103).
// Grão = linha de pagamento (col 0 "Cód." é única). Uma venda com pagamento
// dividido gera N linhas com o mesmo vendaRef; um Day Spa traz vários serviços
// em children[] (resumidos em `servico`).
model MovimentacaoBelle {
  id             Int      @id @default(autoincrement())
  unidadeId      Int
  belleMovId     String              // col 0 "Cód." — ID único da movimentação (chave estável)
  vendaRef       String?             // col 8 "Origem" — ex.: "Venda #22074665" (liga ao Report 183)
  data           String              // col 4 "Confirmação" → "YYYY-MM-DD"
  clienteNome    String
  clienteId      String?
  cpf            String?             // col 5
  responsavel    String?             // col 9 (recepção / terapeuta)
  servico        String?             // resumo dos serviços (children)
  tipoVenda      String?             // tipo do item (children): Voucher | Plano | Serviço | Produto...
  formaPagamento String?             // col 10 (normalizada, sem espaços): "PIX" | "Cartão de Crédito"...
  tipoMovimento  String?             // col 11 "Tipo": E (entrada) | S (saída)
  confirmado     Boolean  @default(true)  // col 16 "Conf." (S/N)
  parcelas       Int      @default(1)     // col 1 "Nº Pcl."
  valorBruto     Float    @default(0)     // col 12
  taxas          Float    @default(0)     // col 13 (taxa adquirente)
  valorDesconto  Float    @default(0)     // do Report 183 (cruzamento posterior)
  valorLiquido   Float    @default(0)     // col 15 (líquido = bruto − taxas)
  statusConcil   String   @default("PENDENTE")  // PENDENTE | CONCILIADA | DIVERGENTE
  importadoEm    DateTime @default(now())
  atualizadoEm   DateTime @updatedAt
  divergencias   Divergencia[]

  @@unique([unidadeId, belleMovId])
  @@index([unidadeId, data])
  @@index([unidadeId, data, formaPagamento])
  @@index([unidadeId, statusConcil])
}

// Evidência externa de pagamento REAL (fonte de verdade), independente do Belle.
model FonteExterna {
  id             Int       @id @default(autoincrement())
  unidadeId      Int
  origem         String    // OPERADORA_CARTAO | BANCO_PIX | CAIXA_DINHEIRO | TOTALPASS | GYMPASS | VOUCHER_SITE
  refExterna     String?   // NSU / id da transação / id do check-in
  data           String    // "YYYY-MM-DD"
  dataHora       DateTime?
  valor          Float     @default(0)
  formaPagamento String?   // bandeira / tipo
  descricao      String?
  raw            String?   // JSON bruto da fonte (auditoria)
  statusMatch    String    @default("PENDENTE")  // PENDENTE | CASADA | SEM_PAR | CLASSIFICADA
  movimentacaoId Int?      // se casou, aponta pra MovimentacaoBelle
  importadoEm    DateTime  @default(now())
  // Classificação na DRE (F2): entrada que não é cliente (ex.: Pix de aporte/transferência)
  // recebe uma conta do plano de contas e passa a alimentar a DRE em vez de ficar divergente.
  planoContaId   Int?
  planoConta     PlanoConta? @relation(fields: [planoContaId], references: [id])
  classificadoEm   DateTime?
  classificadoPor  String?

  @@unique([unidadeId, origem, refExterna])
  @@index([unidadeId, data])
  @@index([unidadeId, origem, statusMatch])
}

// Divergência apontada pelo motor — o que a ponta trata no loop.
model Divergencia {
  id              Int       @id @default(autoincrement())
  unidadeId       Int
  data            String    // "YYYY-MM-DD"
  tipo            String    // FALTA_NO_BELLE | SOBRA_NO_BELLE | VALOR_DIVERGENTE | SEM_CHECKIN | DESCONTO | CORTESIA
  formaPagamento  String?
  valorEsperado   Float     @default(0)
  valorEncontrado Float     @default(0)
  diferenca       Float     @default(0)
  descricao       String?              // explicação em linguagem clara (IA — F5)
  sugestaoAjuste  String?              // sugestão de correção (IA — F5)
  movimentacaoId  Int?
  movimentacao    MovimentacaoBelle? @relation(fields: [movimentacaoId], references: [id])
  fonteExternaId  Int?
  status          String    @default("ABERTA")  // ABERTA | EM_TRATAMENTO | REPROCESSADA | CONCILIADA | JUSTIFICADA | IGNORADA
  tratadaPorId    String?
  tratadaPorNome  String?
  justificativa   String?
  tratadaEm       DateTime?
  aprovadaPorNome String?              // aprovação da justificativa por DONA (proprietário)
  aprovadaEm      DateTime?            // justificada mas SEM aprovadaEm = aguardando aprovação (vermelho)
  reprocessadaEm  DateTime?
  criadaEm        DateTime  @default(now())
  atualizadaEm    DateTime  @updatedAt

  @@index([unidadeId, data, status])
  @@index([unidadeId, tipo])
}

// Resumo por unidade/dia — o painel de conciliação lê daqui.
model ConciliacaoDia {
  id                  Int       @id @default(autoincrement())
  unidadeId           Int
  data                String    // "YYYY-MM-DD"
  totalBelle          Float     @default(0)
  totalConciliado     Float     @default(0)
  qtdMovimentacoes    Int       @default(0)
  qtdDivergencias     Int       @default(0)
  qtdAbertas          Int       @default(0)
  status              String    @default("ABERTO")  // ABERTO | EM_TRATAMENTO | CONCILIADO
  ultimoProcessamento DateTime?
  atualizadoEm        DateTime  @updatedAt

  @@unique([unidadeId, data])
}

// ─── Conciliação de ATENDIMENTOS (Parte 2 — eixo do serviço) ─────────────────────
// A Parte 1 (MovimentacaoBelle) olha o dinheiro que ENTROU. A Parte 2 olha o serviço
// que SAIU: todo atendimento "Atendido" precisa de justificativa (financeira OU não).
// Pega o que a Parte 1 não vê: sessão de plano, voucher local, e cortesia/desconto
// 100% sem autorização. Fontes: Report 7 (universo, chave [0] ID + Plano inline) +
// Report 2421 "Descontos Aplicados" (classificador via coluna Origem Desconto).
// Uma linha por atendimento. Idempotente por (unidadeId, belleAtendId).
model AtendimentoConc {
  id           Int      @id @default(autoincrement())
  unidadeId    Int
  belleAtendId String              // Report 7 [0] ID (mesmo ID que abre a Descrição do 2421/2422)
  data         String              // Report 7 [1] "YYYY-MM-DD"
  horario      String?             // [2]
  clienteNome  String              // [3]
  clienteId    String?             // ID do cliente Belle (via Report 241130472) — chave p/ cruzar MovimentacaoBelle
  servico      String?             // [6]
  tempo        Int?                // [7] (min)
  profissional String?             // [8]
  planoId      String?             // [9] ID do plano (null quando 0 = sem plano)
  tipo         String?             // [11]
  statusAtend  String              // [12] "Atendido" | ...
  valorBruto   Float    @default(0) // valor do serviço (do Report 2421 quando há linha)
  // Rateio de cobertura (R$) — quanto de cada justificativa cobriu o atendimento
  covPlano     Float    @default(0) // coberto por plano/pacote
  covVoucher   Float    @default(0) // coberto por voucher (local/site — subtipo refinado na F2)
  covParceria  Float    @default(0) // coberto por parceria (Gympass/TotalPass promo)
  covCortesia  Float    @default(0) // cortesia (colaborador ou não — regra colaborador na F2)
  covDesconto  Float    @default(0) // desconto discricionário
  covFinanceiro Float   @default(0) // pago em dinheiro/cartão/pix (cruzamento Parte 1 — F2)
  covAberto    Float    @default(0) // não coberto por nada (F2)
  // Classificação da justificativa (árvore F2 completa; F1 = preliminar Report 7+2421):
  //   PLANO | VOUCHER | PARCERIA | CORTESIA | DESCONTO | FINANCEIRO |
  //   A_VERIFICAR_FINANCEIRO (sem plano e sem desconto → provável pago; cruzar Parte 1) |
  //   SEM_JUSTIFICATIVA (F2, quando nem financeiro cobre)
  classificacao  String @default("A_VERIFICAR_FINANCEIRO")
  justificado    Boolean @default(false) // true = justificativa válida (não gera alarme)
  aniversarioMes Boolean @default(false) // cliente faz aniversário no mês do atendimento (Report 1)
  origemDesconto String?             // origens brutas do Report 2421 (auditoria; várias juntadas por " | ")
  divergenciaId  Int?                // se virou divergência (cortesia/desconto/sem-just), aponta pra Divergencia
  importadoEm    DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  @@unique([unidadeId, belleAtendId])
  @@index([unidadeId, data])
  @@index([unidadeId, data, classificacao])
  @@index([unidadeId, classificacao])
  @@index([unidadeId, clienteId, data])
}

// ─── NF Salão Parceiro (controle fiscal) ────────────────────────────────────────
// Lei do Salão Parceiro: o faturamento é dividido entre a terapeuta (MEI, emite a
// própria NF) e o salão (emite 1 NF por terapeuta/mês). Módulo isolado, mesmo padrão
// da Conciliação (unidadeId Int puro, sem relation, pra manter desacoplado). Acesso
// só DONA/FINANCEIRO. Piloto Anália (unidadeId 2), 1ª competência ao vivo = set/2026.

// Competência mensal por unidade: base a emitir (congelada no fechamento) + alíquotas.
model NfSalaoMes {
  id                 Int      @id @default(autoincrement())
  unidadeId          Int
  ano                Int
  mes                Int                         // 1..12 (mês da competência)
  status             String   @default("ABERTO") // ABERTO | FECHADO
  // Alíquotas do mês (mudam por unidade/mês; a Daniana preenche no fechamento)
  aliquotaIss        Float    @default(0)        // % ISS (ex.: 2.39)
  aliquotaTributos   Float    @default(0)        // % tributos aprox. (ex.: 3.67)
  // Base a emitir (memória de cálculo). Fat/reembolso puxados; resto manual.
  faturamentoCaixa   Float    @default(0)        // caixa do mês da competência (gestão)
  reembolsoVoucher   Float    @default(0)        // reembolso voucher do MÊS ANTERIOR (gestão)
  reembolsoGympass   Float    @default(0)        // manual
  reembolsoTotalpass Float    @default(0)        // manual
  notasAvulsas       Float    @default(0)        // NFs já emitidas a clientes — abate da base
  valorBase          Float    @default(0)        // = fat + voucher + gympass + totalpass − avulsas
  // Origem do que foi puxado automático (transparência — a ponta confere/edita)
  faturamentoFonte   String?                     // ex.: "gestao:caixa 2026-08"
  reembolsoFonte     String?                     // ex.: "gestao:reembolso 2026-07"
  fechadoEm          DateTime?
  fechadoPorNome     String?
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  @@unique([unidadeId, ano, mes])
  @@index([unidadeId])
}

// Uma linha por terapeuta/mês = uma NF do salão. Valores da terapeuta vêm da Folha
// (comissão do fechamento + dias de crédito + os nºs das NFs dela). Cálculo do salão
// é derivado da base. RPS e nº da NF preenchidos na emissão.
model NfSalaoTerapeuta {
  id               Int      @id @default(autoincrement())
  nfSalaoMesId     Int
  unidadeId        Int
  // Identidade (da Folha)
  terapeutaNome    String
  cnpjMei          String   @default("")
  folhaTerapeutaId String?                       // id na Folha (casamento)
  // Valores da terapeuta (da Folha) — P = comissão + dias de crédito
  comissao         Float    @default(0)          // G
  diasCredito      Float    @default(0)          // F
  valorTerapeuta   Float    @default(0)          // P (= H na planilha)
  nfComissaoNumero String?                       // C — nº da NF de comissão dela
  nfCreditoNumero  String?                       // B — nº da NF de dias de crédito dela
  // Cálculo do salão
  pct              Float    @default(0)          // N = valorTerapeuta / ΣvalorTerapeuta
  valorNota        Float    @default(0)          // M = base × pct ("valor total recebido")
  baseCalculo      Float    @default(0)          // O = valorNota − valorTerapeuta (base ISS)
  // Emissão do salão na prefeitura
  rps              Int?                           // Q — sequencial interno
  nfSalaoNumero    String?                        // J — nº da NF emitida
  codVerificacao   String?
  emitidaEm        DateTime?
  discriminacao    String   @default("")          // bloco pronto pra copiar/colar
  status           String   @default("PENDENTE")  // PENDENTE | EMITIDA
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  @@index([nfSalaoMesId])
  @@index([unidadeId])
}

// Sequenciador de RPS por unidade (cada CNPJ tem a sua). Trava contra repetir/pular.
model RpsSequencia {
  id           Int      @id @default(autoincrement())
  unidadeId    Int      @unique
  proximoRps   Int      @default(1)
  atualizadoEm DateTime @updatedAt
}

// ─── CONTROLE DA BOLA (rodízio de terapeutas) ────────────────────────────────
// A ÚNICA coisa que não existe no Belle: a fila de chegada ("Cheguei") e os
// atendimentos que a bola mandou. Turno, preferencial, sala, duração e gênero
// (Tipo Obs) vêm do Belle ao vivo. Motor em src/lib/bola/motor.ts.

// Check-in do terapeuta no dia (o "Cheguei"). A hora define a ordem de chegada.
model BolaCheckin {
  id           Int       @id @default(autoincrement())
  unidadeSlug  String
  terapeutaId  Int
  terapeuta    Terapeuta @relation(fields: [terapeutaId], references: [id])
  data         String                       // "YYYY-MM-DD" (fuso America/Sao_Paulo)
  chegadaEm    DateTime  @default(now())     // define a ordem da bola
  // ATIVO | ENCERRADO (saiu / fim do turno)
  status       String    @default("ATIVO")
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@unique([unidadeSlug, terapeutaId, data]) // 1 check-in por terapeuta/dia
  @@index([unidadeSlug, data, status])
}

// Atendimento que a BOLA passou para a terapeuta — fonte de "ocupado" e "rodadas".
// (NÃO confundir com o modelo Atendimento, que vem do Belle para comissão.)
model BolaAtendimento {
  id            Int       @id @default(autoincrement())
  unidadeSlug   String
  terapeutaId   Int
  terapeuta     Terapeuta @relation(fields: [terapeutaId], references: [id])
  data          String                      // "YYYY-MM-DD"
  clienteNome   String?
  servicoNome   String?
  servicoCod    Int?
  duracaoMin    Int
  salaNome      String?                     // sala que veio do Belle
  preferencial  Boolean   @default(false)   // atendimento de cliente verde
  belleAgendaId String?                     // cod_consulta do Belle, se houver
  inicioEm      DateTime  @default(now())    // quando a bola passou (= início)
  fimPrevistoEm DateTime                     // inicioEm + duracaoMin
  criadoEm      DateTime  @default(now())

  @@index([unidadeSlug, data])
  @@index([terapeutaId, data])
}

// ─── Financeiro · Plano de Contas (migrado do app de Estoque) ─────────────────────
// Catálogo global (compartilhado pelas 7 unidades) de contas contábeis para classificar
// entradas/saídas e alimentar a DRE. "tipo" = "A Pagar" | "A Receber".
model PlanoConta {
  id           Int      @id @default(autoincrement())
  nome         String   @unique
  tipo         String   @default("A Pagar")   // "A Pagar" | "A Receber"
  codObrigacao String   @default("")
  codProvisao  String   @default("")
  tipoDespesa  String   @default("")           // "Fixa" | "Variavel" | ""
  ativa        Boolean  @default(true)
  fontes       FonteExterna[]
  titulos      TituloPagar[]
}

// ─── Financeiro · Contas a Pagar (migrado do app de Estoque) ──────────────────────
// Título a pagar por unidade. Alimenta a DRE (por competência) e o Fluxo de Caixa (por
// vencimento/pagamento). Datas em texto "YYYY-MM-DD" (sem fuso). `origem` prepara a ponte
// futura: títulos gerados pelo Estoque (compras/rouparia) chegam aqui como COMPRA/ROUPARIA.
model TituloPagar {
  id                  Int         @id @default(autoincrement())
  unidadeId           Int
  planoContaId        Int?
  planoConta          PlanoConta? @relation(fields: [planoContaId], references: [id])
  descricao           String      @default("")
  fornecedorTexto     String      @default("")
  valor               Float       @default(0)
  parcela             Int         @default(1)
  totalParcelas       Int         @default(1)
  dataEmissao         String                        // "YYYY-MM-DD"
  dataCompetencia     String?                       // "YYYY-MM-DD" (DRE)
  dataVencimento      String?                       // "YYYY-MM-DD" (fluxo previsto)
  dataPagamento       String?                       // "YYYY-MM-DD" (fluxo realizado)
  status              String      @default("PREVISTO")  // PREVISTO | PAGO | CANCELADO
  pagamentoAntecipado Boolean     @default(false)
  formaPagamento      String      @default("")
  observacao          String      @default("")
  origem              String      @default("MANUAL")    // MANUAL | COMPRA | ROUPARIA
  refExterna          String?                           // id do pedido/fatura na origem (idempotência)
  criadoEm            DateTime    @default(now())
  atualizadoEm        DateTime    @updatedAt

  @@index([unidadeId, status])
  @@index([unidadeId, dataVencimento])
  @@index([unidadeId, dataCompetencia])
}

// Validação/conciliação do reembolso de parcerias: o valor LÍQUIDO que de fato
// entrou na conta (por parceria/unidade/mês) vs o calculado (atendimentos × flat),
// com justificativa da diferença. Espelha o valorRecebido dos vouchers online.
model ParceriaConciliacao {
  id            Int      @id @default(autoincrement())
  ano           Int
  mes           Int
  unidadeId     Int
  parceria      String   // 'totalpass' | 'gympass'
  recebido      Float    @default(0)
  justificativa String   @default("")
  conciliado    Boolean  @default(false)
  atualizadoEm  DateTime @updatedAt

  @@unique([ano, mes, unidadeId, parceria])
  @@index([ano, mes])
}

// Cache do nº de casos de NPS pendentes de tratativa (por unidade/mês), p/ o badge do
// menu lateral. Atualizado quando a página de NPS abre (agir-hoje), ao salvar tratativa
// e pelo cron diário. Lido pelo /api/rotinas/nps-pendentes.
model NpsPendentesCache {
  id           Int      @id @default(autoincrement())
  unidadeId    Int
  mesRef       String   // "YYYY-MM"
  pendentes    Int      @default(0)
  totalMes     Int      @default(0)
  atualizadoEm DateTime @updatedAt

  @@unique([unidadeId, mesRef])
}
